# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Clé publique du projet : selon la date de création du projet Supabase, le
# dashboard peut l'appeler "anon key" ou "publishable key" — les deux noms
# de variable sont acceptés (voir lib/supabase/env.ts), utilise celui que
# Supabase/Vercel te propose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Origine publique du site (sans barre finale), pour les liens des e-mails
# d'inscription et de réinitialisation. Obligatoire en production : sans
# elle, l'origine est déduite de la requête.
NEXT_PUBLIC_SITE_URL=https://tidebound.example
